{
  "name": "claude-wrap",
  "version": "0.7.0",
  "description": "Multi-model launcher for Claude Code — pick any LLM backend via presets",
  "type": "module",
  "license": "MIT",
  "author": "Bara Digital",
  "repository": "github.com/bara-digital/claude-wrap",
  "homepage": "https://github.com/bara-digital/claude-wrap#readme",
  "bugs": "https://github.com/bara-digital/claude-wrap/issues",
  "keywords": [
    "claude-code",
    "llm",
    "cli",
    "multi-model",
    "deepseek",
    "openai",
    "anthropic"
  ],
  "bin": {
    "claude-wrap": "./dist/claude-wrap"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --compile --outfile dist/claude-wrap",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
